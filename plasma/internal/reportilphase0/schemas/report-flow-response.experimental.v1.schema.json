{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plasma:report-flow-response:experimental:v1",
  "title": "Plasma Phase 0 Product Flow Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "flow_attestation"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "pipeline_family", "document_id", "revision_id", "narrative_contract_id", "title", "language", "blocks", "provenance"],
      "properties": {
        "schema_version": {"const": "plasma.report_il.experimental.v1"},
        "pipeline_family": {"const": "report_il_experimental"},
        "document_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "narrative_contract_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "kind"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["section", "prose", "list", "quote", "code", "table", "callout"]},
              "parent_node_id": {"type": "string"},
              "level": {"type": "integer", "minimum": 1, "maximum": 6},
              "title": {"type": "string"},
              "prose": {"type": "string"},
              "items": {"type": "array", "items": {"type": "string"}},
              "code": {"type": "string"},
              "language": {"type": "string"},
              "table": {
                "type": "object",
                "additionalProperties": false,
                "required": ["columns", "rows"],
                "properties": {
                  "caption": {"type": "string"},
                  "columns": {"type": "array", "items": {"type": "string"}},
                  "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
                }
              },
              "semantic_role": {"enum": ["opening", "context", "claim", "mechanism", "evidence", "example", "contrast", "caveat", "implication", "synthesis", "transition", "conclusion"]},
              "supports": {"type": "array", "items": {"type": "string"}},
              "qualifies": {"type": "array", "items": {"type": "string"}},
              "contrasts_with": {"type": "array", "items": {"type": "string"}},
              "elaborates": {"type": "array", "items": {"type": "string"}},
              "refers_to": {"type": "array", "items": {"type": "string"}},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "requirement_refs": {"type": "array", "items": {"type": "string"}},
              "presentation_intent": {"enum": ["prose", "supporting", "formal_display", "keep_with_next"]}
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref_id", "kind", "target"],
            "properties": {
              "ref_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["citation", "footnote", "cross_reference"]},
              "target": {"type": "string", "minLength": 1},
              "visible_label": {"type": "string"},
              "locator": {"type": "string"}
            }
          }
        },
        "provenance": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
      }
    },
    "flow_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "document_id", "revision_id", "linear_projection_sha256", "reviewer", "reviewed_full_manuscript", "central_thread_preserved", "section_handoffs_resolved", "open_loops_resolved", "terminology_continuous", "verdict"],
      "properties": {
        "schema_version": {"const": "plasma.report_flow_attestation.experimental.v1"},
        "document_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "linear_projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_full_manuscript": {"const": true},
        "central_thread_preserved": {"type": "boolean"},
        "section_handoffs_resolved": {"type": "boolean"},
        "open_loops_resolved": {"type": "boolean"},
        "terminology_continuous": {"type": "boolean"},
        "accidental_repetition_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "detail"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        },
        "abrupt_transition_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "detail"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        },
        "unsupported_addition_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "detail"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        },
        "verdict": {"enum": ["accept", "revise", "reject"]}
      }
    }
  }
}
